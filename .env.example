DATABASE_URL="postgresql://user:password@localhost:5432/barber_pro?schema=public"
# Em provedores com connection pooler (ex: Neon), aponte para a conexão
# DIRETA (sem "-pooler" no host) — usada só pelo "prisma migrate deploy".
# Se seu banco não tem pooler, pode repetir o mesmo valor de DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/barber_pro?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NODE_ENV="development"

# Pasta onde arquivos enviados pelo painel (logo de cada empresa) ficam
# salvos no disco do servidor. Numa VPS/Coolify, aponte para um caminho
# dentro de um volume persistente — sem isso, os uploads somem a cada novo
# deploy. Caminho relativo (padrão) funciona em desenvolvimento.
UPLOAD_DIR="./uploads"

# Segredo da rota POST /api/system/seed — só necessário se você for popular
# o banco por HTTP (ex: Vercel, sem terminal no servidor). Numa VPS com
# acesso a terminal, prefira rodar "pnpm run db:seed" direto.
SEED_SECRET=""

# Senhas iniciais criadas pelo seed (SUPERADMIN da plataforma, contas da
# empresa demo "Queiroz Barbearia" e da empresa de teste). Opcionais — se
# deixadas em branco, uma senha aleatória é gerada e devolvida uma única vez
# (log do servidor ou resposta da rota de seed). Defina aqui só se quiser
# controlar a senha inicial você mesmo.
SUPERADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_TEST_COMPANY_PASSWORD=""

# Segredo da rota POST /api/system/cron/overdue-expenses — acionada por um
# cron externo (ex: agendamento do Coolify, cron-job.org) pra notificar
# despesas vencidas em todas as empresas. Sem ele, a rota recusa qualquer
# chamada.
CRON_SECRET=""

# WhatsApp integration (deixe em branco / "mock" para usar o modo mock em desenvolvimento)
WHATSAPP_PROVIDER="mock"

# --- Provedor "evolution" (Evolution API self-hosted, via Baileys) ---
# Conecte o número escaneando o QR code em /admin/whatsapp depois do deploy.
EVOLUTION_API_URL="https://your-evolution-instance.example.com"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="barberpro"

# --- Provedor "cloud_api" (Meta WhatsApp Cloud API) ---
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Número da barbearia que recebe alertas internos de novos agendamentos.
# Com WHATSAPP_PROVIDER="evolution", o número já conectado na instância
# (pareado via QR code em /admin/whatsapp) é usado automaticamente — esta
# variável só serve de fallback quando não há instância conectada, ou ao
# usar o provedor "cloud_api". Deixe em branco para não ter fallback.
BARBERSHOP_WHATSAPP_NUMBER=""
